---
import '../styles/global.css';
const { title } = Astro.props;
const links = [
  ['/#medfacts', 'MedFacts101'],
  ['/#track', 'Track'],
  ['/#experience', 'Experience'],
  ['/#school', 'School'],
  ['/resume.pdf', 'Resume'],
];
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <nav>
      {links.map(([href, label]) => (
        <a href={href}>{label}</a>
      ))}
    </nav>
    <main>
      <slot />
    </main>
    <footer>
      <p>Email: <a href="mailto:okyeremichael662@gmail.com">okyeremichael662@gmail.com</a></p>
      <p><a href="https://www.linkedin.com/in/michaeltokyere/">LinkedIn</a></p>
    </footer>
  </body>
</html>
